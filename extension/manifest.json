{
  "manifest_version": 3,
  "name": "DDB Roll Sync",
  "version": "1.1",
  "description": "Syncs D&D Beyond dice rolls and session notes to Supabase.",
  "permissions": [
    "storage",
    "sidePanel",
    "declarativeNetRequestWithHostAccess",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.dndbeyond.com/*",
    "https://vtrtyagltwdrbastpppl.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
